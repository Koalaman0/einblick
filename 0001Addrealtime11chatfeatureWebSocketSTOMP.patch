+                                  CONSTRAINT uq_chat_room_pair UNIQUE (user_a_id, user_b_id)
+);
+
+CREATE TABLE IF NOT EXISTS chat_messages (
+                                  chat_message_id BIGINT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
+                                  chat_room_id    BIGINT NOT NULL,
+                                  sender_id       BIGINT NOT NULL,
+                                  content         VARCHAR(2000) NOT NULL,
+                                  created_at      TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,
+                                  CONSTRAINT fk_chatmsg_room   FOREIGN KEY (chat_room_id) REFERENCES chat_rooms(chat_room_id),
+                                  CONSTRAINT fk_chatmsg_sender FOREIGN KEY (sender_id)    REFERENCES users(user_id)
+);
+
+CREATE INDEX IF NOT EXISTS idx_chatmsg_room ON chat_messages(chat_room_id, created_at);
