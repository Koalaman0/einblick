From 0112f4234863191526afdcefd0bf89f5d913fe4e Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Fri, 11 Sep 2026 09:55:12 +0000
Subject: [PATCH] Add production docker-compose for self-hosting on Oracle
 Cloud Free Tier

Railway's free credit ran out, so this adds a self-contained deploy
setup for moving the backend + Postgres to an always-free VM (Oracle
Cloud's Always Free shape, or any VM with Docker) instead of paying
for Railway Hobby.

deploy/docker-compose.prod.yml runs three containers: Postgres
(seeded from Backend/sql on first start via docker-entrypoint-initdb.d),
the Spring Boot backend (built from the existing Backend/Dockerfile,
same DATABASE_URL/JWT_SECRET/CORS_ALLOWED_ORIGINS env vars it already
reads), and Caddy as a reverse proxy that auto-provisions and renews
a Let's Encrypt TLS cert for BACKEND_DOMAIN - needed because the
Vercel frontend is served over HTTPS and browsers block a plain-HTTP
API call from an HTTPS page. No backend code changes were needed;
this is purely new deploy config.

deploy/.env.example documents the variables to fill into deploy/.env
(gitignored) before running `docker compose -f docker-compose.prod.yml
up -d --build` on the VM. Includes a note about the sslip.io trick
for getting Caddy a real cert without owning a domain (e.g.
"1-2-3-4.sslip.io" resolves to 1.2.3.4).

Co-Authored-By: Claude Sonnet 5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01X9yZ7cHnDzcjxUURarrjHg
---
 .gitignore                     |  4 +++
 deploy/.env.example            | 15 ++++++++++
 deploy/Caddyfile               |  3 ++
 deploy/docker-compose.prod.yml | 53 ++++++++++++++++++++++++++++++++++
 4 files changed, 75 insertions(+)
 create mode 100644 deploy/.env.example
 create mode 100644 deploy/Caddyfile
 create mode 100644 deploy/docker-compose.prod.yml

diff --git a/.gitignore b/.gitignore
index c26a76e..64469c8 100644
--- a/.gitignore
+++ b/.gitignore
@@ -35,3 +35,7 @@ out/
 
 ### VS Code ###
 .vscode/
+
+### Deployment secrets ###
+deploy/.env
+
diff --git a/deploy/.env.example b/deploy/.env.example
new file mode 100644
index 0000000..a9f8786
--- /dev/null
+++ b/deploy/.env.example
@@ -0,0 +1,15 @@
+# deploy/.env로 복사해서 실제 값 채우기 (deploy/.env는 git에 커밋되지 않음)
+
+# Postgres 비밀번호 - 아무 임의 문자열로 새로 생성해서 사용 (Railway 때 쓰던 값 재사용 금지)
+POSTGRES_PASSWORD=change-me
+
+# JWT 서명 키 - openssl rand -base64 48 등으로 새로 생성
+JWT_SECRET=change-me
+
+# Vercel 프론트엔드 주소(들). 여러 개면 콤마로 구분 (예: 프로덕션 도메인 + Vercel 프리뷰 도메인)
+CORS_ALLOWED_ORIGINS=https://your-app.vercel.app
+
+# 이 백엔드가 응답할 도메인. 실제 도메인이 없으면 오라클 VM의 공인 IP를 그대로
+# "1-2-3-4.sslip.io" 형식으로 써도 됨 (sslip.io가 그 IP로 자동으로 풀어줌) -
+# Caddy가 이 도메인으로 Let's Encrypt 인증서를 자동 발급/갱신한다.
+BACKEND_DOMAIN=1-2-3-4.sslip.io
diff --git a/deploy/Caddyfile b/deploy/Caddyfile
new file mode 100644
index 0000000..238455c
--- /dev/null
+++ b/deploy/Caddyfile
@@ -0,0 +1,3 @@
+{$BACKEND_DOMAIN} {
+	reverse_proxy backend:8080
+}
diff --git a/deploy/docker-compose.prod.yml b/deploy/docker-compose.prod.yml
new file mode 100644
index 0000000..0f859ea
--- /dev/null
+++ b/deploy/docker-compose.prod.yml
@@ -0,0 +1,53 @@
+services:
+  postgres:
+    image: postgres:16
+    container_name: einblick-postgres
+    restart: unless-stopped
+    environment:
+      POSTGRES_DB: einblick
+      POSTGRES_USER: einblick
+      POSTGRES_PASSWORD: ${POSTGRES_PASSWORD}
+    volumes:
+      - postgres-data:/var/lib/postgresql/data
+      - ../Backend/sql:/docker-entrypoint-initdb.d
+    healthcheck:
+      test: ["CMD-SHELL", "pg_isready -U einblick -d einblick"]
+      interval: 10s
+      timeout: 5s
+      retries: 10
+
+  backend:
+    build:
+      context: ../Backend
+    container_name: einblick-backend
+    restart: unless-stopped
+    depends_on:
+      postgres:
+        condition: service_healthy
+    environment:
+      DATABASE_URL: postgresql://einblick:${POSTGRES_PASSWORD}@postgres:5432/einblick
+      JWT_SECRET: ${JWT_SECRET}
+      CORS_ALLOWED_ORIGINS: ${CORS_ALLOWED_ORIGINS}
+    expose:
+      - "8080"
+
+  caddy:
+    image: caddy:2
+    container_name: einblick-caddy
+    restart: unless-stopped
+    depends_on:
+      - backend
+    environment:
+      BACKEND_DOMAIN: ${BACKEND_DOMAIN}
+    ports:
+      - "80:80"
+      - "443:443"
+    volumes:
+      - ./Caddyfile:/etc/caddy/Caddyfile
+      - caddy-data:/data
+      - caddy-config:/config
+
+volumes:
+  postgres-data:
+  caddy-data:
+  caddy-config:
-- 
