# deploy/.env로 복사해서 실제 값 채우기 (deploy/.env는 git에 커밋되지 않음)

# Postgres 비밀번호 - 아무 임의 문자열로 새로 생성해서 사용 (Railway 때 쓰던 값 재사용 금지)
POSTGRES_PASSWORD=change-me

# JWT 서명 키 - openssl rand -base64 48 등으로 새로 생성
JWT_SECRET=change-me

# Vercel 프론트엔드 주소(들). 여러 개면 콤마로 구분 (예: 프로덕션 도메인 + Vercel 프리뷰 도메인)
CORS_ALLOWED_ORIGINS=https://your-app.vercel.app

# 이 백엔드가 응답할 도메인. 실제 도메인이 없으면 오라클 VM의 공인 IP를 그대로
# "1-2-3-4.sslip.io" 형식으로 써도 됨 (sslip.io가 그 IP로 자동으로 풀어줌) -
# Caddy가 이 도메인으로 Let's Encrypt 인증서를 자동 발급/갱신한다.
BACKEND_DOMAIN=1-2-3-4.sslip.io
