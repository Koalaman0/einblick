-index 0f859ea..f2341b0 100644
---- a/deploy/docker-compose.prod.yml
-+++ b/deploy/docker-compose.prod.yml
-@@ -3,6 +3,15 @@ services:
-     image: postgres:16
-     container_name: einblick-postgres
-     restart: unless-stopped
-+    mem_limit: 300m
-+    command:
-+      - postgres
-+      - -c
-+      - shared_buffers=64MB
-+      - -c
-+      - max_connections=20
-+      - -c
-+      - work_mem=4MB
-     environment:
-       POSTGRES_DB: einblick
-       POSTGRES_USER: einblick
-@@ -21,6 +30,7 @@ services:
-       context: ../Backend
-     container_name: einblick-backend
-     restart: unless-stopped
-+    mem_limit: 500m
-     depends_on:
-       postgres:
-         condition: service_healthy
-@@ -28,6 +38,8 @@ services:
-       DATABASE_URL: postgresql://einblick:${POSTGRES_PASSWORD}@postgres:5432/einblick
-       JWT_SECRET: ${JWT_SECRET}
-       CORS_ALLOWED_ORIGINS: ${CORS_ALLOWED_ORIGINS}
-+      # E2.1.Micro는 1GB RAM뿐이라 힙/메타스페이스를 명시적으로 좁게 잡아야 OOM 없이 뜬다.
-+      JAVA_TOOL_OPTIONS: "-Xmx350m -Xss256k -XX:MaxMetaspaceSize=150m"
-     expose:
-       - "8080"
- 
-@@ -35,6 +47,7 @@ services:
