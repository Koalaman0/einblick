From 97bb8bfd55f9139fb88cb4794dbea449403888af Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Fri, 11 Sep 2026 11:20:21 +0000
Subject: [PATCH] Tune docker-compose memory limits for VM.Standard.E2.1.Micro
 (1GB RAM)

A1.Flex was out of capacity, so the target VM is the older x86 Always
Free shape instead - 1 OCPU / 1GB RAM. Without limits, Postgres +
Spring Boot + Caddy together can exceed that and get OOM-killed, and
the JVM in particular sizes its default heap as a fraction of visible
container memory rather than something safe for 1GB total.

- mem_limit per service (postgres 300m, backend 500m, caddy 100m)
  leaves headroom under 1GB for the OS and swap spikes.
- Postgres started with shared_buffers=64MB, max_connections=20,
  work_mem=4MB instead of its defaults (sized for far more RAM).
- Backend gets JAVA_TOOL_OPTIONS capping heap/metaspace/thread stack
  size explicitly, since leaving it to JVM ergonomics risks an OOM
  kill during startup class loading.

Co-Authored-By: Claude Sonnet 5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01X9yZ7cHnDzcjxUURarrjHg
---
 deploy/docker-compose.prod.yml | 14 ++++++++++++++
 1 file changed, 14 insertions(+)

diff --git a/deploy/docker-compose.prod.yml b/deploy/docker-compose.prod.yml
index 0f859ea..f2341b0 100644
--- a/deploy/docker-compose.prod.yml
+++ b/deploy/docker-compose.prod.yml
@@ -3,6 +3,15 @@ services:
     image: postgres:16
     container_name: einblick-postgres
     restart: unless-stopped
+    mem_limit: 300m
+    command:
+      - postgres
+      - -c
+      - shared_buffers=64MB
+      - -c
+      - max_connections=20
+      - -c
+      - work_mem=4MB
     environment:
       POSTGRES_DB: einblick
       POSTGRES_USER: einblick
@@ -21,6 +30,7 @@ services:
       context: ../Backend
     container_name: einblick-backend
     restart: unless-stopped
+    mem_limit: 500m
     depends_on:
       postgres:
         condition: service_healthy
@@ -28,6 +38,8 @@ services:
       DATABASE_URL: postgresql://einblick:${POSTGRES_PASSWORD}@postgres:5432/einblick
       JWT_SECRET: ${JWT_SECRET}
       CORS_ALLOWED_ORIGINS: ${CORS_ALLOWED_ORIGINS}
+      # E2.1.Micro는 1GB RAM뿐이라 힙/메타스페이스를 명시적으로 좁게 잡아야 OOM 없이 뜬다.
+      JAVA_TOOL_OPTIONS: "-Xmx350m -Xss256k -XX:MaxMetaspaceSize=150m"
     expose:
       - "8080"
 
@@ -35,6 +47,7 @@ services:
     image: caddy:2
     container_name: einblick-caddy
     restart: unless-stopped
+    mem_limit: 100m
     depends_on:
       - backend
     environment:
@@ -51,3 +64,4 @@ volumes:
   postgres-data:
   caddy-data:
   caddy-config:
+
-- 
2.43.0

